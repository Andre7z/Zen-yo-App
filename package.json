{
  "name": "zenyo-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm --prefix frontend run dev",
    "dev:api": "cd backend && poetry run uvicorn app.main:app --reload",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run preview",
    "lint": "npm --prefix frontend run lint",
    "test": "npm --prefix frontend run test"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
